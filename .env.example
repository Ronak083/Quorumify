# Copy this file to .env and fill in values for local development.
# Do NOT commit .env to git.

# ── Docker Compose ───────────────────────────────────────────────────────────
# Your DockerHub username (used to pull images in docker-compose.yml)
DOCKER_USERNAME=ronak083

# ── React Build-time (only needed when building image locally) ───────────────
# When using Nginx proxy (docker-compose), the proxy handles /api/ routing —
# this var is only needed if building the image to call an external API directly.
REACT_APP_API_URL=http://localhost:8080/api/
